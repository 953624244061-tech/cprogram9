#include <stdio.h>

int main() {
    int n, temp, digit, rev = 0;

    scanf("%d", &n);
    temp = n;

    while (temp > 0) {
        digit = temp % 10;
        rev = rev * 10 + digit;
        temp /= 10;
    }

    printf("Reverse = %d\n", rev);

    if (n == rev)
        printf("Palindrome Number");
    else
        printf("Not a Palindrome Number");

    return 0;
}
